{
  "version": 8,
  "name": "Oceanography Offline Style",
  "sources": {
    "ghana": {
      "type": "vector",
      "url": "{path_to_mbtiles}"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#e6f2ff"
      }
    },
    {
      "id": "contour-0m",
      "type": "line",
      "source": "ghana",
      "source-layer": "ne_50m_coastline",
      "paint": {
        "line-color": "#000000",
        "line-width": 1.5
      }
    },
    {
      "id": "admin-borders",
      "type": "line",
      "source": "ghana",
      "source-layer": "ne_10m_admin_0_boundary_lines_land",
      "paint": {
        "line-color": "#444444",
        "line-width": 1
      }
    },
    {
      "id": "contour-50m",
      "type": "line",
      "source": "ghana",
      "source-layer": "contour_50m (1) — contour",
      "paint": {
        "line-color": "#99ccff",
        "line-width": 0.3,
        "line-opacity": 0.7
      }
    },
    {
      "id": "contour-100m",
      "type": "line",
      "source": "ghana",
      "source-layer": "contour_100m (1) — contour",
      "paint": {
        "line-color": "#4da6ff",
        "line-width": 0.3,
        "line-opacity": 0.7
      }
    },
    {
      "id": "contour-500m",
      "type": "line",
      "source": "ghana",
      "source-layer": "contour_500m (1) — contour",
      "paint": {
        "line-color": "#0066cc",
        "line-width": 0.3,
        "line-opacity": 0.7
      }
    }
  ]
}